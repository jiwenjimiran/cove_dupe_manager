<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cove.DuplicateManager</AssemblyName>
    <RootNamespace>Cove.DuplicateManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="extension.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Include="dist\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup Condition="'$(CoveHostAssemblyDir)' != ''">
    <Reference Include="Cove.Plugins"><HintPath>$(CoveHostAssemblyDir)\Cove.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cove.Sdk"><HintPath>$(CoveHostAssemblyDir)\Cove.Sdk.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cove.Core"><HintPath>$(CoveHostAssemblyDir)\Cove.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cove.Data"><HintPath>$(CoveHostAssemblyDir)\Cove.Data.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" ExcludeAssets="runtime" />
    <PackageReference Include="Npgsql" Version="10.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="Pgvector" Version="0.3.2" ExcludeAssets="runtime" />
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCovePlugins)' == 'false' and '$(CoveHostAssemblyDir)' == ''">
    <PackageReference Include="Cove.Plugins" Version="$(CovePluginsVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCovePlugins)' == 'true' and '$(CoveHostAssemblyDir)' == ''">
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Plugins\Cove.Plugins.csproj" Condition="'$(CoveSourceRoot)' != ''">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Sdk\Cove.Sdk.csproj" Condition="'$(CoveSourceRoot)' != ''">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Core\Cove.Core.csproj" Condition="'$(CoveSourceRoot)' != ''">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="$(CoveSourceRoot)\src\Cove.Data\Cove.Data.csproj" Condition="'$(CoveSourceRoot)' != ''">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\cove\src\Cove.Plugins\Cove.Plugins.csproj" Condition="'$(CoveSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\cove\src\Cove.Plugins\Cove.Plugins.csproj')">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\src\Cove.Plugins\Cove.Plugins.csproj" Condition="'$(CoveSourceRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\..\src\Cove.Plugins\Cove.Plugins.csproj')">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
